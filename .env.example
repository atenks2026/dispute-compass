# PayPal Developer Sandbox credentials (developer.paypal.com → Apps & Credentials → Sandbox).
# A regular paypal.com login does NOT give Client ID / Secret — create a Sandbox app first.
# Leave empty to run in Demo Mode (8 built-in cases, no network needed).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM for the AI Case Coach + Letter Studio — any OpenAI-compatible endpoint.
# Default targets NVIDIA NIM (free account: integrate.api.nvidia.com).
# Aliases accepted: NIM_API_KEY / NIM_BASE_URL / NIM_MODEL.
# Leave empty to run AI features in deterministic template mode (clearly labeled in the UI).
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
